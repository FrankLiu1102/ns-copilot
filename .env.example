# NS-Copilot Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# API Keys
# =============================================================================
# Anthropic API key for Claude models
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API key for GPT models
OPENAI_API_KEY=your_openai_api_key_here

# HuggingFace token (required for REVE EEG foundation model)
# 1. Create account at https://huggingface.co
# 2. Request access at https://huggingface.co/brain-bzh/reve-base
# 3. Create a Read token at https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# =============================================================================
# Model Storage
# =============================================================================
# Directory where foundation models are stored
# Default: ./models (relative to project root)
# Run ./setup.sh to automatically download models to this location
MODELS_DIR=./models

# Alternative: Use absolute path if models are already downloaded elsewhere
# Example: MODELS_DIR=/absolute/path/to/your/models

# =============================================================================
# Application Settings
# =============================================================================
# Controller mode: off / auto / force
# - off:   No retry, run once
# - auto:  Auto Model Selection Mode (Codex CLI baseline → foundation model search → early stopping)
# - force: Standard execution with forced N retries (default)
CONTROLLER_MODE=force

# Number of improvement iterations when CONTROLLER_MODE=force
FORCE_IMPROVEMENT_COUNT=2

# Codex CLI baseline model (used in auto mode as the baseline to beat)
CODEX_BASELINE_MODEL=gpt-5.2-codex

# Maximum retry rounds in auto mode (each round runs all models once with Controller optimization)
# Recommended: 1-5. Higher values increase runtime significantly (each round ≈ N models × 2-5 min)
AUTO_MAX_RETRIES=2

# Optional: a performance threshold for auto mode's early stopping.  When set,
# it replaces the Codex-derived baseline; a model must EXCEED it to stop the
# search early.  It applies to the primary metric the Planner selects, which is
# printed at the start of every run and recorded in audit.json.
# Example: AUTO_TARGET_VALUE=0.85
# AUTO_TARGET_VALUE=


# Use GPT-4 when no dataset is provided
USE_GPT4_FOR_NO_DATASET=true

# =============================================================================
# Dataset
# =============================================================================
# Optional: default dataset path inside the container (used when no file is uploaded via web UI)
# Example: DEFAULT_DATASET_PATH=/app/dataset/Parkinson/ds004584
# DEFAULT_DATASET_PATH=

# =============================================================================
# Web Server
# =============================================================================
HOST=0.0.0.0
PORT=8001

# =============================================================================
# External Services
# =============================================================================
# Ollama base URL (for local LLM inference)
OLLAMA_BASE_URL=http://localhost:11434

# =============================================================================
# Docker Container User (avoids root-owned output files)
# =============================================================================
# Run: id -u  and  id -g  to get your UID/GID
# HOST_UID=1000
# HOST_GID=1000

# =============================================================================
# Paths (Advanced)
# =============================================================================
# Knowledge base path (relative to container)
KB_PATH=/app/knowledge_base/index/kb.sqlite

# Foundation model paths (optional overrides — auto-detected if not set)
# NDT3_PATH=${MODELS_DIR}/ndt3
# NDT3_CHECKPOINT_PATH=${MODELS_DIR}/ndt3/data/pretrained/753jmg4u/checkpoints/val-epoch=397-val_loss=0.4987.ckpt
# MTM_PATH=${MODELS_DIR}/mtm
# MTM_CHECKPOINT_PATH=${MODELS_DIR}/mtm/checkpoints/multi-NDT1-MtM-10-sessions/model_best.pt
# POYO_PATH=${MODELS_DIR}/poyo
# POYO_CHECKPOINT_PATH=${MODELS_DIR}/poyo/checkpoints/poyo_1.ckpt
# LABRAM_PATH=${MODELS_DIR}/labram
# LABRAM_CHECKPOINT_PATH=${MODELS_DIR}/labram/checkpoints/labram-base.pth
# CBRAMOD_PATH=${MODELS_DIR}/cbramod
# CBRAMOD_CHECKPOINT_PATH=${MODELS_DIR}/cbramod/pretrained_weights/pretrained_weights.pth
# EEGPT_PATH=${MODELS_DIR}/eegpt
# EEGPT_CHECKPOINT_PATH=${MODELS_DIR}/eegpt/checkpoint/eegpt_mcae_58chs_4s_large4E.ckpt
# EEGMAMBA_PATH=${MODELS_DIR}/eegmamba
# EEGMAMBA_CHECKPOINT_PATH=${MODELS_DIR}/eegmamba/pretrained_weights/pretrained_EEGMamba.pth
# BRAINOMNI_PATH=${MODELS_DIR}/brainomni
# BRAINOMNI_CHECKPOINT_PATH=${MODELS_DIR}/brainomni/pretrained_weights/tiny/BrainOmni.pt
# REVE: No local path needed — loaded from HuggingFace at runtime (requires HF_TOKEN)
